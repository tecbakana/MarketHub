# MarketHub — variáveis de produção
# Copie para .env na VM e preencha os valores

# RabbitMQ (interno — não mude se usar o docker-compose padrão)
RABBITMQ_URL=amqp://markethub:markethub123@rabbitmq:5672

# PostgreSQL (interno — não mude se usar o docker-compose padrão)
DATABASE_URL=postgresql://markethub:markethub123@postgres:5432/markethub

# Aggregator
SYNC_INTERVAL_MINUTES=15
API_URL=http://api:4000

# Mercado Livre — credenciais do app (não são tokens de usuário)
ML_CLIENT_ID=2859385768182439
ML_CLIENT_SECRET=PREENCHER

# Spedy — emissão de NF
SPEDY_API_KEY=bddc1ed3-6c54-40eb-93d5-72e45d29363a
SPEDY_SANDBOX=true

# Autenticação inter-serviços (troque por um valor forte em produção)
MARKETHUB_SECRET=PREENCHER_SENHA_FORTE

# Tenant padrão (CArtPersonalizados)
TENANT_ID=fdef75b7-3b26-4590-8dcd-1bea76eb6120
